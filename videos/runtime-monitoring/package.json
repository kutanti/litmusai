{
  "name": "runtime-monitoring",
  "version": "1.0.0",
  "description": "LitmusAI runtime monitoring story, narration, and launch assets",
  "repository": "https://github.com/kutanti/litmusai",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/captions": "4.0.526",
    "@remotion/cli": "4.0.526",
    "@remotion/google-fonts": "4.0.526",
    "@remotion/media": "4.0.526",
    "@remotion/transitions": "4.0.526",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.526"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.526",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "^9.39.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render RuntimeStory out/litmusai-runtime-story.mp4 --codec=h264 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=192k --crf=19 --concurrency=4",
    "poster": "remotion still RuntimeStory out/litmusai-runtime-cover.png --frame=190",
    "captions": "node scripts/export-captions.mjs",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
